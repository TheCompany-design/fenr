# Fenr — copy to apps/web/.env and fill in real values.
#
# Postgres connection string. Provision a per-project database on the shared
# local instance with ~/services/create-project-db.sh <name>.
DATABASE_URL=postgres://<user>:<password>@localhost:5432/<database>?sslmode=disable

# Dedicated test database (isolated from dev to prevent test suites from wiping dev data).
# Created automatically with suffix _test or provisioned via ~/services/create-project-db.sh <database>_test
TEST_DATABASE_URL=postgres://<user>:<password>@localhost:5432/<database>_test?sslmode=disable

# Better Auth secret (openssl rand -base64 32) — at least 32 chars.
BETTER_AUTH_SECRET=

# Base URL of the app (auth callback base).
BETTER_AUTH_URL=http://localhost:3000

# Mailer / SMTP configuration
EMAIL_FROM="Fenr <no-reply@fenr.app>"
SMTP_MAILER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Google OAuth credentials (optional in dev; required to activate Google social sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
