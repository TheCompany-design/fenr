    "@tanstack/router-plugin": "latest",
    "@workspace/database": "workspace:*",
    "@workspace/ui": "workspace:*",
    "better-auth": "^1.7.1",
    "motion": "^13.1.1",
    "pino": "^10.3.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "3.8.0",
