{
  "name": "fenr",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "bun run --cwd apps/web server.ts",
    "test": "bun test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write . && turbo run typecheck",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:migrate": "bun run --cwd packages/database db:migrate",
    "auth:generate": "bun run --cwd apps/web auth:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "turbo": "^2.9.18",
    "typescript": "^6"
  },
  "patchedDependencies": {
    "@tanstack/router-ssr-query-core@1.169.1": "patches/@tanstack%2Frouter-ssr-query-core@1.169.1.patch"
  }
}
